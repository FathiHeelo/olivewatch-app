# URL of the AI gateway (gateway/). Never put a Gemini key here: VITE_ variables are bundled into the page.
# When unset, or when the gateway is unreachable, the AI features show their simulated state, labelled as such.
VITE_AI_URL=http://localhost:8787
# ZAYTOUN_API_URL for the dashboard: the Zaytoun Vision backend (zaytoun-backend/) behind the UV Scan tool.
# A public address, not a secret (the backend needs no keys). Unset or unreachable => a clear "no result" message.
VITE_ZAYTOUN_API_URL=http://127.0.0.1:8000
