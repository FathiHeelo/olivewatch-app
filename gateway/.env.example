# Copy to .env and fill in. .env is git-ignored; never commit a real key and never expose it to the apps
# (no EXPO_PUBLIC_ / VITE_ prefix): the gateway is the only thing that talks to Gemini.
GEMINI_API_KEY=
PORT=8787
# Comma-separated list of origins allowed by CORS (dev servers of platform, landing and mobile web).
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5175,http://localhost:8081
# Optional tuning
# RATE_LIMIT_PER_MINUTE=30
# MAX_BODY_MB=5
