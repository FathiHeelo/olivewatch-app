# URL of the AI gateway (gateway/). Never put a Gemini key here: EXPO_PUBLIC_ variables are bundled into the app.
# On a phone use your computer LAN address, e.g. http://192.168.1.20:8787. Unset or unreachable => the mock, labelled simulated.
EXPO_PUBLIC_AI_URL=http://localhost:8787
# ZAYTOUN_API_URL for the app: the Zaytoun Vision backend (zaytoun-backend/) that runs the UV screening.
# A public address, not a secret; the backend needs no keys. Unset or unreachable => a clear "no result" message.
EXPO_PUBLIC_ZAYTOUN_API_URL=http://127.0.0.1:8000
