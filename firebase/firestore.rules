rules_version = '2';

// =====================================================================================
// DEMO RULES (test-mode style). NOT for production. NOT deployed by this repo.
//
// Test mode lets anyone with the project id read and write every document until the
// expiry date below. That is fine for a hackathon demo with sample data and nothing
// personal in it. REMINDER: Firestore test-mode rules expire 30 days after creation;
// after that every request is denied. Before real users or real farm data:
//   1. replace this with per-user rules (Firebase Auth) and
//   2. do NOT collect personal data (e.g. emails for a pilot form) while these are on,
//      because anything stored here is world-readable.
// To use: paste into Firebase console > Firestore > Rules, or `firebase deploy --only firestore:rules`
// (only when you decide to).
// =====================================================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Set this to a date ~30 days from today, then re-check it.
      allow read, write: if request.time < timestamp.date(2026, 12, 2);
    }
  }
}
